@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MapQuest.Data
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
<PageTitle>Manage Users - MapQuest Admin</PageTitle>
<div class="admin-container">
    <div class="admin-header">
        <h1><span class="header-gradient">Manage System Users</span></h1>
        <p class="subtitle">Manage user accounts, view active accounts, assign system roles, or remove accounts.</p>
    </div>
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ErrorMessage
        </div>
    }
    <div class="admin-actions mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <a href="admin/users/create" class="btn btn-premium">
            <i class="bi bi-person-plus-fill me-2"></i> Create New User
        </a>
        <form method="get" class="search-form">
            <div class="input-group">
                <input type="text" name="search" class="form-control search-input" placeholder="Search by email..." value="@Search" />
                <button type="submit" class="btn btn-search">
                    Search
                </button>
            </div>
        </form>
    </div>
    <div class="admin-card mb-4">
        <div class="card-body p-0">
            @if (UsersWithRoles.Count == 0)
            {
                <div class="empty-state p-5 text-center">
                    <i class="bi bi-people-fill display-3 text-muted mb-3"></i>
                    <h3>No users found</h3>
                    <p class="text-muted">No users match your criteria. Try adjusting your search term.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table premium-table align-middle">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email Status</th>
                                <th>Assigned Roles</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var userModel in UsersWithRoles)
                            {
                                <tr>
                                    <td>
                                        <div class="user-info">
                                            <div class="user-avatar">
                                                @userModel.Email[0].ToString().ToUpper()
                                            </div>
                                            <div class="user-details">
                                                <div class="user-email">@userModel.Email</div>
                                                <div class="user-id text-muted">ID: @userModel.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (userModel.EmailConfirmed)
                                        {
                                            <span class="role-badge badge-success"><i class="bi bi-patch-check-fill me-1"></i> Verified</span>
                                        }
                                        else
                                        {
                                            <span class="role-badge badge-warning"><i class="bi bi-patch-question-fill me-1"></i> Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (userModel.Roles.Count == 0)
                                        {
                                            <span class="text-muted italic small">No Roles</span>
                                        }
                                        else
                                        {
                                            @foreach (var role in userModel.Roles)
                                            {
                                                <span class="role-badge @(role == "Admin" ? "badge-admin" : "badge-user") me-1">
                                                    @role
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a href="admin/users/@userModel.Id/roles" class="btn btn-action btn-edit" title="Manage Roles">
                                                Roles
                                            </a>

                                            @if (userModel.Email == "admin@mapquest.com")
                                            {
                                                <button class="btn btn-action btn-delete" style="opacity: 0.5; cursor: not-allowed;" title="System Administrator account cannot be deleted" disabled>
                                                    Delete
                                                </button>
                                            }
                                            else
                                            {
                                                <form method="post" action="admin/users" @formname="DeleteUserForm" class="d-inline">
                                                    <AntiforgeryToken />
                                                    <input type="hidden" name="DeleteUserId" value="@userModel.Id" />
                                                    <button type="submit" class="btn btn-action btn-delete" title="Delete User">
                                                        Delete
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
@code {
    private List<UserWithRolesModel> UsersWithRoles { get; set; } = new();
    [SupplyParameterFromQuery]
    private string? Search { get; set; }
    [SupplyParameterFromForm(FormName = "DeleteUserForm")]
    private string? DeleteUserId { get; set; }
    private string? SuccessMessage { get; set; }
    private string? ErrorMessage { get; set; }
    protected override async Task OnInitializedAsync()
    {
        // Execute delete if form submitted
        if (!string.IsNullOrEmpty(DeleteUserId))
        {
            await ExecuteDeleteUser(DeleteUserId);
            DeleteUserId = null;
        }
        await LoadUsers();
    }
    private async Task LoadUsers()
    {
        var usersQuery = UserManager.Users;
        if (!string.IsNullOrWhiteSpace(Search))
        {
            var cleanSearch = Search.Trim();
            usersQuery = usersQuery.Where(u => u.Email!.Contains(cleanSearch) || u.UserName!.Contains(cleanSearch));
        }
        var usersList = await usersQuery.ToListAsync();
        UsersWithRoles.Clear();
        foreach (var user in usersList)
        {
            var roles = await UserManager.GetRolesAsync(user);
            UsersWithRoles.Add(new UserWithRolesModel
            {
                Id = user.Id,
                Email = user.Email ?? "Unknown",
                EmailConfirmed = user.EmailConfirmed,
                Roles = roles.ToList()
            });
        }
    }
    private async Task ExecuteDeleteUser(string id)
    {
        var user = await UserManager.FindByIdAsync(id);
        if (user == null)
        {
            ErrorMessage = "User not found.";
            SuccessMessage = null;
            return;
        }
        if (user.Email == "admin@mapquest.com")
        {
            ErrorMessage = "The primary seed administrator account cannot be deleted.";
            SuccessMessage = null;
            return;
        }
        var result = await UserManager.DeleteAsync(user);
        if (result.Succeeded)
        {
            SuccessMessage = $"User '{user.Email}' was deleted successfully!";
            ErrorMessage = null;
        }
        else
        {
            ErrorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            SuccessMessage = null;
        }
    }
    public class UserWithRolesModel
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public bool EmailConfirmed { get; set; }
        public List<string> Roles { get; set; } = new();
    }
}