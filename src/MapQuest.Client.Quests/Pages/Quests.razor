@page "/mijnpuzzeltochten"
@using MapQuest.Client.Interfaces
@using Syncfusion.Blazor.Data
@using Microsoft.AspNetCore.Authorization
@inject SfDialogService DialogService
@inject IQuestService questService

@attribute [Authorize]

<PageTitle>Mijn puzzeltochten</PageTitle>

<SfGrid @ref="gridRef" TValue="Models.Quest" AllowPaging="true">
    <GridEvents TValue="Models.Quest"  CommandClicked="@GridCommandClicked" />
    <SfDataManager Adaptor="Adaptors.CustomAdaptor" AdaptorInstance="@typeof(QuestDataAdaptor)" />
    <GridPageSettings PageSize="5" PageSizes="@(new string[] { "5", "10", "20" })" PageCount="3" />
    <GridColumns>
        <GridColumn Field="@nameof(Models.Quest.Name)" HeaderText="Naam" TextAlign="TextAlign.Left" Width="200"></GridColumn>
        <GridColumn Field="@nameof(Models.Quest.CalculatedDistance)" HeaderText="Locatie" TextAlign="TextAlign.Left" Width="200">
            <Template>
                @{
                    var quest = (context as Models.Quest);
                    if (quest?.CalculatedDistance == null)
                    {
                        <span></span>
                    }
                    else if (quest.CalculatedDistance > 10000)
                    {
                        <span>@(Geo.GeoService.GetCoordinatesPresentation(quest.Lat, quest.Lon))</span>
                    }
                    else if (quest.CalculatedDistance > 1000)
                    {
                        <span>@(Geo.GeoService.GetCoordinatesPresentation(quest.Lat, quest.Lon))</span>
                    }
                    else
                    {
                        <span>@(Geo.GeoService.GetCoordinatesPresentation(quest.Lat, quest.Lon))</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(Models.Quest.CalculatedDistance)" HeaderText="Afstand tot locatie" TextAlign="TextAlign.Left" Width="200">
            <Template>
                @{
                    var quest = (context as Models.Quest);
                    if (quest?.CalculatedDistance == null)
                    {
                        <span></span>
                    }
                    else if (quest.CalculatedDistance > 10000)
                    {
                        <span>@((quest.CalculatedDistance.Value / 1000.0).ToString("0")) km</span>
                    }
                    else if (quest.CalculatedDistance > 1000)
                    {
                        <span>@((quest.CalculatedDistance.Value / 1000.0).ToString("0.0")) km</span>
                    }
                    else
                    {
                        <span>@(quest.CalculatedDistance.Value.ToString("0")) m</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn>
            <GridCommandColumns>
                <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { Content = "Bewerk", IconCss = "e-icons e-edit" })" />
                <GridCommandColumn Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() { Content = "Verwijder", IconCss = "e-icons e-delete" })" />
            </GridCommandColumns>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfButton Content="Aanmaken" OnClick="@OpenAddQuestDialog" />

<AddOrEditQuestDialog @ref="addOrEditQuestDialog" OnQuestEdited="@OnQuestEdited" />

@code {
    private SfGrid<Models.Quest>? gridRef;
    private AddOrEditQuestDialog? addOrEditQuestDialog;

    private async Task OpenAddQuestDialog()
    {
        await addOrEditQuestDialog!.OpenDialog(null);
    }

    private async void OnQuestEdited()
    {
        await gridRef!.Refresh();
    }

    private async Task GridCommandClicked(CommandClickEventArgs<Models.Quest> e)
    {
        if (e.CommandColumn?.Type == CommandButtonType.Delete)
        {
            if (await DialogService.ConfirmAsync("Weet je zeker dat je deze puzzeltocht wilt verwijderen?", "Verwijder puzzeltocht", new DialogOptions()
            {
                PrimaryButtonOptions = new DialogButtonOptions() { Content = "Ja" },                
                CancelButtonOptions = new DialogButtonOptions() { Content = "Nee" }
            }))
            {
                await questService.DeleteQuestsAsync(e.RowData!.Id, null);
                await gridRef!.Refresh();
            }
        }
        else if (e.CommandColumn?.Type == CommandButtonType.Edit)
        {
            await addOrEditQuestDialog!.OpenDialog(e.RowData);
        }
    }
}
