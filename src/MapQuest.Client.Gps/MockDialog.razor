@using System
@using MapQuest.Interfaces
@implements IDisposable
@inject IGpsService GpsService

<SfDialog Width="380px" ShowCloseIcon="true" @bind-Visible="@IsVisible"  AllowDragging="true">
	<DialogTemplates>
		<Header> Gps-locatie </Header>
		<Content>
			<SfTextBox Value="@(GpsService.IsMocked ? "Mocking Actief" : "Echte GPS Actief")"
					   Placeholder="GPS-status"
					   FloatLabelType="FloatLabelType.Always"
					   Readonly="true" />

			<SfNumericTextBox TValue="double?"
							  Value="@GpsService.CurrentLocation?.Latitude"
							  Placeholder="Huidige breedtegraad"
							  FloatLabelType="FloatLabelType.Always"
							  Readonly="true"
							  ShowSpinButton="false"
							  Format="F6" />

			<SfNumericTextBox TValue="double?"
							  Value="@GpsService.CurrentLocation?.Longitude"
							  Placeholder="Huidige lengtegraad"
							  FloatLabelType="FloatLabelType.Always"
							  Readonly="true"
							  ShowSpinButton="false"
							  Format="F6" />

			<SfNumericTextBox TValue="double"
							  @bind-Value="@_mockLatitude"
							  Placeholder="Nagebootste breedtegraad"
							  FloatLabelType="FloatLabelType.Always"
							  ShowSpinButton="false"
							  Format="F6" />

			<SfNumericTextBox TValue="double"
							  @bind-Value="@_mockLongitude"
							  Placeholder="Nagebootste lengtegraad"
							  FloatLabelType="FloatLabelType.Always"
							  ShowSpinButton="false"
							  Format="F6" />

			<SfNumericTextBox TValue="double"
							  @bind-Value="@_mockAccuracy"
							  Placeholder="Nagebootste nauwkeurigheid (meters)"
							  FloatLabelType="FloatLabelType.Always"
							  ShowSpinButton="false"
							  Format="F0" />

			<SfButton Content="Nagebootste locatie instellen"
					  OnClick="@OnSetMockClick" />

			@if (GpsService.IsMocked)
			{
				<SfButton Content="Herstellen naar echte GPS"
						  OnClick="@OnResetClick" />
			}
		</Content>
	</DialogTemplates>
	<DialogButtons>
		<DialogButton Content="Sluiten" OnClick="@OnCloseClick" />
	</DialogButtons>
</SfDialog>


@code {
	private bool IsVisible { get; set; } = false;
	private double _mockLatitude;
	private double _mockLongitude;
	private double _mockAccuracy = 50.0;

	protected override void OnInitialized()
	{
		GpsService.OnLocationUpdated += GpsService_OnLocationUpdated;
	}

	public void OpenDialog()
	{
		if (GpsService.CurrentLocation != null)
		{
			_mockLatitude = GpsService.CurrentLocation.Latitude;
			_mockLongitude = GpsService.CurrentLocation.Longitude;
			_mockAccuracy = GpsService.CurrentLocation.Accuracy ?? 50.0;
		}
		IsVisible = true;
		StateHasChanged();
	}

	private void OnCloseClick()
	{
		IsVisible = false;
	}

	private void OnSetMockClick()
	{
		GpsService.SetMockLocation(_mockLatitude, _mockLongitude, _mockAccuracy);
	}

	private void OnResetClick()
	{
		GpsService.DisableMock();
		if (GpsService.CurrentLocation != null)
		{
			_mockLatitude = GpsService.CurrentLocation.Latitude;
			_mockLongitude = GpsService.CurrentLocation.Longitude;
			_mockAccuracy = GpsService.CurrentLocation.Accuracy ?? 50.0;
		}
	}

	private void GpsService_OnLocationUpdated(object? sender, GpsCoordinates? e)
	{
		if (!GpsService.IsMocked && e != null)
		{
			_mockLatitude = e.Latitude;
			_mockLongitude = e.Longitude;
			_mockAccuracy = e.Accuracy ?? 50.0;
		}
		InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		GpsService.OnLocationUpdated -= GpsService_OnLocationUpdated;
	}
}
